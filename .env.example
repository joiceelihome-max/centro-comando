# ============================================================
# CENTRO DE COMANDO — .env.example
# Copie para .env e preencha antes de subir
# ============================================================

# ── ANTHROPIC ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXX

# ── AIRTABLE ────────────────────────────────────────────────
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ── SEGURANÇA WEBHOOK ────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=cole_token_gerado_aqui

# ── N8N ─────────────────────────────────────────────────────
N8N_HOST=seu-projeto.up.railway.app
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://seu-projeto.up.railway.app
N8N_USER=admin
N8N_PASSWORD=troque_para_senha_forte

# ── URL DO BACKEND (usada pelo n8n) ─────────────────────────
BACKEND_URL=https://seu-backend.up.railway.app

# ── WHATSAPP via Z-API (gratuito) ────────────────────────────
# Crie conta em: https://z-api.io
ZAPI_INSTANCE_ID=XXXXXXXX
ZAPI_TOKEN=XXXXXXXX
ZAPI_URL=https://api.z-api.io/instances/XXXXXXXX/token/XXXXXXXX

# ── NÚMEROS (com DDI+DDD, sem + ou espaços) ──────────────────
WHATSAPP_ADULTO_1=5511999999999
WHATSAPP_ADULTO_2=5511888888888
WHATSAPP_CRIANCA_1=
WHATSAPP_CRIANCA_2=

# ── APP ─────────────────────────────────────────────────────
FLASK_ENV=production
PORT=5000
LOG_LEVEL=INFO
