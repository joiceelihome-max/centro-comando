            { "name": "message", "value": "={{ $json.mensagem }}" }
          ]
        },
        "options": {}
      },
      "id": "n5",
      "name": "📱 WhatsApp — Enviar Mensagem",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 20 * * *" }]
        }
      },
      "id": "n6",
      "name": "⏰ Cron — 20h Resumo do Dia",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 520]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/familiar/ranking",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "={{ $env.WEBHOOK_SECRET }}" }
          ]
        },
        "options": {}
      },
      "id": "n7",
      "name": "🏆 Buscar Ranking XP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 520]
    },
    {
      "parameters": {
        "jsCode": "const ranking = $json.data.ranking || [];\nconst linhas = ['🏆 *Ranking Familiar de Hoje!*\\n'];\n\nranking.forEach((m, i) => {\n  const medalha = i === 0 ? '🥇' : i === 1 ? '🥈' : '🥉';\n  linhas.push(`${medalha} ${m.avatar} *${m.nome}* — ${m.xp} XP — ${m.nivel}`);\n});\n\nlinhas.push('\\n💪 Amanhã é um novo dia de missões!');\n\nreturn [{ json: { mensagem: linhas.join('\\n') } }];"
      },
      "id": "n8",
      "name": "🔄 Montar Mensagem Ranking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.zapi.io/instances/{{ $env.ZAPI_INSTANCE_ID }}/token/{{ $env.ZAPI_TOKEN }}/send-text",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "phone", "value": "={{ $env.WHATSAPP_ADULTO_1 }}" },
            { "name": "message", "value": "={{ $json.mensagem }}" }
          ]
        },
        "options": {}
      },
      "id": "n9",
      "name": "📱 WhatsApp — Ranking Noturno",
      "type": "n8n-nodes-base.httpRequest",
